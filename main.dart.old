class EyesProblemPage extends StatefulWidget {
  const EyesProblemPage({super.key});

  @override
  State<EyesProblemPage> createState() =>
      _EyesProblemPageState();
}

class _EyesProblemPageState
    extends State<EyesProblemPage> {
  final TextEditingController _promptController =
  TextEditingController();

  final ScrollController _scrollController =
  ScrollController();

  final List<Map<String, String>> _messages = [];

  @override
  void dispose() {
    _promptController.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  void _submitPrompt() {
    final text = _promptController.text.trim();

    if (text.isEmpty) return;

    setState(() {
      _messages.add({
        'role': 'User',
        'message': text,
      });

      _messages.add({
        'role': 'Assistant',
        'message':
        'This is where the eye-related information or response will appear.',
      });
    });

    _promptController.clear();

    FocusScope.of(context).unfocus();

    Future.delayed(const Duration(milliseconds: 100), () {
      if (_scrollController.hasClients) {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final hasMessages = _messages.isNotEmpty;

    return SafeArea(
      child: Column(
        children: [
          // ==================================================
          // CHAT AREA
