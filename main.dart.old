                          ? Theme.of(context)
                          .colorScheme
                          .primary
                          : Theme.of(context)
                          .colorScheme
                          .surfaceContainerHighest,
                      borderRadius:
                      BorderRadius.circular(16),
                    ),
                    child: RichText(
                      text: TextSpan(
                        children: [
                          TextSpan(
                            text:
                            '${message['role']}: ',
                            style: TextStyle(
                              fontWeight:
                              FontWeight.bold,
                              color: isUser
                                  ? Colors.white
                                  : Theme.of(context)
                                  .colorScheme
                                  .onSurface,
                            ),
                          ),
                          TextSpan(
                            text: message['message'],
                            style: TextStyle(
                              color: isUser
                                  ? Colors.white
                                  : Theme.of(context)
                                  .colorScheme
                                  .onSurface,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                );
              },
            )
                : Column(
              mainAxisAlignment:
              MainAxisAlignment.center,
              children: [
                Icon(
                  Icons.remove_red_eye,
                  size: 72,
                  color: Theme.of(context)
                      .colorScheme
                      .primary,
                ),
                const SizedBox(height: 16),
                Text(
                  'Eyes Problem',
                  textAlign: TextAlign.center,
                  style: Theme.of(context)
                      .textTheme
                      .headlineSmall
                      ?.copyWith(
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 8),
                Text(
                  'Ask about diabetic eye problems, vision changes, and eye care.',
                  textAlign: TextAlign.center,
                  style: Theme.of(context)
                      .textTheme
                      .bodyLarge,
                ),
              ],
            ),
          ),

          // ==================================================
          // PROMPT FIELD - ALWAYS VISIBLE
          // ==================================================

          Padding(
            padding: const EdgeInsets.fromLTRB(
              16,
              8,
              16,
              16,
            ),
            child: TextField(
              controller: _promptController,
              textInputAction: TextInputAction.send,
              minLines: 1,
